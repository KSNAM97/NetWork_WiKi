# ========================================================
# 1. 기본 설정: 모든 마크다운 기본 통계 제외
# (반드시 맨 위에 작성해야 아래 규칙들이 이를 덮어씁니다)
# ========================================================
*.md linguist-language=Markdown
*.md linguist-detectable=false

# ========================================================
# 2. 제목(파일 이름) 기반 강제 매핑
# 파일명 앞뒤로 *를 붙여 특정 단어가 포함된 파일을 찾습니다.
# ========================================================

# 이름에 'Linux' 또는 'Shell'이 포함된 파일 -> Shell
*Linux*.md linguist-language=Shell
*Linux*.md linguist-detectable=true
*Shell*.md linguist-language=Shell
*Shell*.md linguist-detectable=true

# 이름에 'HTML' 또는 'DB'가 포함된 파일 -> HTML
*HTML*.md linguist-language=HTML
*HTML*.md linguist-detectable=true
*DB*.md linguist-language=HTML
*DB*.md linguist-detectable=true

# 이름에 'Docker'가 포함된 파일 -> Dockerfile
*Docker*.md linguist-language=Dockerfile
*Docker*.md linguist-detectable=true

# 이름에 'Kuberneties'가 포함된 파일 -> Go
*Kuberneties*.md linguist-language=Go
*Kuberneties*.md linguist-detectable=true

# 이름에 'Ansible'이 포함된 파일 -> Python
*Ansible*.md linguist-language=Python
*Ansible*.md linguist-detectable=true

# 이름에 'AWS'가 포함된 파일 -> Python
*AWS*.md linguist-language=Python
*AWS*.md linguist-detectable=true

# 이름에 'Terraform' 또는 'Network'가 포함된 파일 -> HCL
*Terraform*.md linguist-language=HCL
*Terraform*.md linguist-detectable=true
*Network*.md linguist-language=HCL
*Network*.md linguist-detectable=true

# 이름에 'System'이 포함된 파일 -> Shell
*System*.md linguist-language=Shell
*System*.md linguist-detectable=true

# ========================================================
# 3. 옵시디언(Obsidian) 설정 파일 포함
# ========================================================
.obsidian/**/*.css linguist-language=CSS
.obsidian/**/*.css linguist-detectable=true
.obsidian/**/*.js linguist-language=JavaScript
.obsidian/**/*.js linguist-detectable=true
.obsidian/**/*.json linguist-language=JSON
.obsidian/**/*.json linguist-detectable=true
